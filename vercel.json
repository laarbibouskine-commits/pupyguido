      "permanent": false
    },
    {
      "source": "/go/double-sided-flannel-pet-bed-small-dogs",
      "destination": "https://temu.to/k/e8zehclz6uj",
      "permanent": false
    },
    {
      "source": "/go/double-sided-flannel-pet-bed-small-dogs/",
